<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="Calculator.MainMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Page.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="Resources/Resources.xaml" />
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Page.Resources>


	<Grid>

		<Grid>
			<StackPanel HorizontalAlignment="Center" Background="Gray" Width="800" Height="600">
				<Image Source="/Images/abacus.jpg"  HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Height="120"/>


				<TextBlock Text="Universal Calculator"
				   FontSize="24"
				   HorizontalAlignment="Center"
				   Margin="10"/>

				<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
					<Button x:Name="MathCalculatorButton" Content="Math Calculator" Click="MathCalculatorButton_Click" Margin="5" Background="Beige"/>
					<Button x:Name="MortgageCalculatorButton" Content="Mortgage Calculator" Click="MortgageCalculatorButton_Click" Margin="5" Background="Beige"/>
					<Button x:Name="CurrencyCalculatorButton" Content="Currency Calculator" Click="CurrencyCalculatorButton_Click" Margin="5" Background="Beige"/>
					<Button x:Name="ExitButton" Content="Exit" Click="ExitButton_Click" Margin="5" Background="Beige"/>
					<Button x:Name="TripButton" Content="Trip" Click="TripCalculateButton_Click" Margin="5" Background="Beige"/>
				</StackPanel>

			</StackPanel>

		</Grid>

	</Grid>
</Page>

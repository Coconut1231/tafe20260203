<Page
    x:Class="Calculator.ForeignExchangeCurrencyCalculator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Grid Background="Pink" Padding="20">

		<StackPanel
            Background="LightGray"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Width="600"
            Height="800"
            Padding="20">

			<!-- Title -->
			<TextBlock
                Text="Currency Conversion Calculator"
                FontSize="32"
                FontWeight="Bold"
                HorizontalAlignment="Center"
                Margin="0,0,0,20"/>

			<!-- Input Section -->
			<Grid Margin="0,0,0,10">

				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1*"/>
					<ColumnDefinition Width="1*"/>
					<ColumnDefinition Width="1*"/>
				</Grid.ColumnDefinitions>

				<!-- Amount -->
				<StackPanel
                    Grid.Column="0"
                    Margin="5"
                    Background="Aquamarine">

					<TextBlock
                        Text="Amount $"
                        FontSize="20"/>

					<TextBox
                        x:Name="amountTextBox"
                        PlaceholderText="Please enter amount"/>
				</StackPanel>

				<!-- From Currency -->
				<StackPanel
                    Grid.Column="1"
                    Margin="5"
                    Background="LightBlue">

					<TextBlock
                        Text="From"
                        FontSize="20"/>

					<ComboBox
                        x:Name="fromCurrencyComboBox"
                        Width="150"
                        HorizontalAlignment="Center"
                        Margin="5">

						<ComboBoxItem Tag="USD">
							<StackPanel Orientation="Horizontal">
								<Image
                                    Source="/Images/USA1.PNG"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,0"/>
								<TextBlock Text="USD - US Dollar"/>
							</StackPanel>
						</ComboBoxItem>

						<ComboBoxItem Tag="EUR">
							<StackPanel Orientation="Horizontal">
								<Image
                                    Source="/Images/EUR1.PNG"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,0"/>
								<TextBlock Text="EUR - Euro"/>
							</StackPanel>
						</ComboBoxItem>

						<ComboBoxItem Tag="GBP">
							<StackPanel Orientation="Horizontal">
								<Image
                                    Source="/Images/UK1.PNG"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,0"/>
								<TextBlock Text="GBP - British Pound"/>
							</StackPanel>
						</ComboBoxItem>

						<ComboBoxItem Tag="INR">
							<StackPanel Orientation="Horizontal">
								<Image
                                    Source="/Images/INDIA.PNG"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,0"/>
								<TextBlock Text="INR - Indian Rupee"/>
							</StackPanel>
						</ComboBoxItem>

					</ComboBox>
				</StackPanel>

				<!-- To Currency -->
				<StackPanel
                    Grid.Column="2"
                    Margin="5"
                    Background="DeepPink">

					<TextBlock
                        Text="To"
                        FontSize="20"/>

					<ComboBox
                        x:Name="toCurrencyComboBox"
                        Width="150"
                        HorizontalAlignment="Center"
                        Margin="5">

						<ComboBoxItem Tag="USD">
							<StackPanel Orientation="Horizontal">
								<Image
                                    Source="/Images/USA1.PNG"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,0"/>
								<TextBlock Text="USD - US Dollar"/>
							</StackPanel>
						</ComboBoxItem>

						<ComboBoxItem Tag="EUR">
							<StackPanel Orientation="Horizontal">
								<Image
                                    Source="/Images/EUR1.PNG"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,0"/>
								<TextBlock Text="EUR - Euro"/>
							</StackPanel>
						</ComboBoxItem>

						<ComboBoxItem Tag="GBP">
							<StackPanel Orientation="Horizontal">
								<Image
                                    Source="/Images/UK1.PNG"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,0"/>
								<TextBlock Text="GBP - British Pound"/>
							</StackPanel>
						</ComboBoxItem>

						<ComboBoxItem Tag="INR">
							<StackPanel Orientation="Horizontal">
								<Image
                                    Source="/Images/INDIA.PNG"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,5,0"/>
								<TextBlock Text="INR - Indian Rupee"/>
							</StackPanel>
						</ComboBoxItem>

					</ComboBox>
				</StackPanel>

			</Grid>

			<!-- Output Section -->
			<StackPanel
                Background="LightSkyBlue"
                Width="300"
                Height="200"
                Margin="40,20,0,0"
                HorizontalAlignment="Left"
                Padding="10">

				<TextBlock
                    x:Name="resultTextBlock"
                    FontSize="22"
                    FontWeight="Bold"
                    TextWrapping="Wrap"
                    Margin="0,10,0,5"/>

				<TextBlock
                    x:Name="rateTextBlock"
                    FontSize="16"
                    TextWrapping="Wrap"
                    Margin="0,5,0,10"/>

			</StackPanel>

			<!-- Buttons -->
			<StackPanel HorizontalAlignment="Center">

				<Button
                    x:Name="calculateCurrencyButton"
                    Content="Calculate Currency"
                    Click="calculateCurrencyButton_Click"
                    Margin="0,10,0,5"
                    Background="Gray"/>

				<Button
                    x:Name="exitButton"
                    Content="Exit"
                    Click="exitButton_Click"
                    Background="Gray"/>

			</StackPanel>

		</StackPanel>

	</Grid>
</Page>